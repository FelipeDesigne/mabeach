# Copie para .env.local e preencha. Só identificadores públicos do Firebase (nada secreto vai no app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ma-beach.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ma-beach
VITE_FIREBASE_STORAGE_BUCKET=ma-beach.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chave pública dos avisos (Console > Configurações do projeto > Cloud Messaging > Certificados push da Web)
VITE_FIREBASE_VAPID_KEY=
# Proteção contra robôs (App Check com reCAPTCHA Enterprise). Opcional até ser configurado.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# true para usar os emuladores locais no `npm run dev`
VITE_USE_EMULATORS=false
